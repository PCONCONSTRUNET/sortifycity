PORT=3000
SESSION_SECRET=troque-essa-chave-em-producao
ADMIN_PASSWORD=pconconstrunet

# Supabase > Project Settings > Database > Connection string > URI
# Use a conexão "Session pooler" ou "Direct connection" e troque [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Se precisar rodar local sem SSL, use PGSSLMODE=disable. No Supabase deixe SSL ligado.
# PGSSLMODE=disable

# PagBank > Venda online > Integracoes > Gerar Token
# Use sandbox para testes e production para pagamentos reais.
PAGBANK_ENV=sandbox
PAGBANK_TOKEN=
PAGBANK_PIX_EXPIRES_HOURS=24
PUBLIC_BASE_URL=http://localhost:3000
