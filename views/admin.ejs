<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin - Sortify City</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="dashboard-body admin-body">
    <%
      let pageTitle = "Dashboard";
      let pageSubtitle = "Visao geral das lojas, assinaturas e operacao.";
      if (activeTab === "financeiro") {
        pageTitle = "Financeiro";
        pageSubtitle = "Receitas, faturas, filtros e pagamentos.";
      } else if (activeTab === "clientes") {
        pageTitle = "Clientes";
        pageSubtitle = "Lojas cadastradas na plataforma.";
      } else if (activeTab === "planos") {
        pageTitle = "Planos";
        pageSubtitle = "Edite os valores e beneficios dos planos disponiveis.";
      } else if (activeTab === "assinantes") {
        pageTitle = "Assinantes";
        pageSubtitle = "Planos, vencimentos e liberacao de acesso por loja.";
      }
    %>

    <div class="saas-shell admin-shell">
      <aside class="saas-sidebar admin-sidebar">
        <div class="saas-brand">
          <img src="/assets/sortify-city-logo.png" alt="Logo Sortify City" class="saas-brand-logo" />
        </div>

        <p class="saas-menu-label">Admin</p>
        <nav class="saas-menu">
          <a href="/admin?tab=dashboard" class="saas-menu-item <%= activeTab === 'dashboard' ? 'active' : '' %>">
            Dashboard
          </a>
          <a href="/admin?tab=financeiro" class="saas-menu-item <%= activeTab === 'financeiro' ? 'active' : '' %>">
            Financeiro
          </a>
          <a href="/admin?tab=clientes" class="saas-menu-item <%= activeTab === 'clientes' ? 'active' : '' %>">
            Clientes
          </a>
          <a href="/admin?tab=planos" class="saas-menu-item <%= activeTab === 'planos' ? 'active' : '' %>">
            Planos
          </a>
          <a href="/admin?tab=assinantes" class="saas-menu-item <%= activeTab === 'assinantes' ? 'active' : '' %>">
            Assinantes
          </a>
        </nav>

        <div class="saas-sidebar-footer">
          <p><strong>Administrador</strong></p>
          <p>Sortify City</p>
          <form method="POST" action="/admin/logout">
            <button type="submit" class="saas-logout-button">Sair do admin</button>
          </form>
        </div>
      </aside>

      <main class="saas-main admin-main">
        <header class="saas-main-header admin-main-header">
          <div>
            <p class="admin-eyebrow">Painel administrativo</p>
            <h1><%= pageTitle %></h1>
            <p><%= pageSubtitle %></p>
          </div>

          <a href="/dashboard" class="admin-store-link">Painel da loja</a>
        </header>

        <% if (flash) { %>
          <div class="flash <%= flash.type %>"><%= flash.message %></div>
        <% } %>

        <% if (activeTab === "dashboard") { %>
          <section class="admin-kpi-grid">
            <article class="admin-kpi-card green">
              <span>Lojas cadastradas</span>
              <strong><%= adminStats.totalStores %></strong>
              <small><%= adminStats.newStores30Days %> nova(s) nos ultimos 30 dias</small>
            </article>
            <article class="admin-kpi-card blue">
              <span>Assinaturas ativas</span>
              <strong><%= adminStats.activeSubscriptions %></strong>
              <small><%= adminStats.inactiveSubscriptions %> sem plano ativo</small>
            </article>
            <article class="admin-kpi-card amber">
              <span>MRR estimado</span>
              <strong><%= adminStats.monthlyRecurringRevenue %></strong>
              <small>Planos ativos na base</small>
            </article>
            <article class="admin-kpi-card red">
              <span>Faturas vencidas</span>
              <strong><%= adminStats.overdueInvoices %></strong>
              <small><%= adminStats.overdueDisplay %> em aberto</small>
            </article>
          </section>

          <section class="admin-dashboard-grid">
            <div class="admin-data-panel">
              <div class="admin-panel-head">
                <h2>Lojas recentes</h2>
                <a href="/admin?tab=clientes">Ver todas</a>
              </div>

              <% if (!recentStores.length) { %>
                <p class="saas-muted">Nenhuma loja cadastrada ainda.</p>
              <% } else { %>
                <div class="admin-table-wrap compact">
                  <table class="admin-table">
                    <thead>
                      <tr>
                        <th>Loja</th>
                        <th>Plano</th>
                        <th>Sorteios</th>
                        <th>Clientes</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% recentStores.forEach((store) => { %>
                        <tr>
                          <td>
                            <strong><%= store.store_name %></strong>
                            <span><%= store.email %></span>
                          </td>
                          <td>
                            <span class="admin-status-pill <%= store.subscriptionActive ? 'success' : 'muted' %>">
                              <%= store.plan_name %>
                            </span>
                          </td>
                          <td><%= store.total_raffles %></td>
                          <td><%= store.total_clients %></td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>

            <div class="admin-data-panel">
              <div class="admin-panel-head">
                <h2>Saude da operacao</h2>
                <a href="/admin?tab=financeiro">Financeiro</a>
              </div>

              <div class="admin-health-list">
                <div>
                  <span>Recebido</span>
                  <strong><%= adminStats.receivedDisplay %></strong>
                </div>
                <div>
                  <span>Em aberto</span>
                  <strong><%= adminStats.openDisplay %></strong>
                </div>
                <div>
                  <span>Sorteios criados</span>
                  <strong><%= adminStats.totalRaffles %></strong>
                </div>
                <div>
                  <span>Participacoes publicas</span>
                  <strong><%= adminStats.totalParticipants %></strong>
                </div>
              </div>
            </div>
          </section>
        <% } %>

        <% if (activeTab === "financeiro") { %>
          <section class="admin-finance-layout admin-finance-layout-full">
            <div class="admin-finance-main">
              <form method="GET" action="/admin" class="admin-filter-bar">
                <input type="hidden" name="tab" value="financeiro" />

                <div class="admin-filter-field">
                  <label for="finance_status">Status</label>
                  <select id="finance_status" name="status">
                    <option value="all" <%= financeFilters.status === 'all' ? 'selected' : '' %>>Todos</option>
                    <% invoiceStatuses.filter((status) => status !== "Sem cobranca").forEach((status) => { %>
                      <option value="<%= status %>" <%= financeFilters.status === status ? 'selected' : '' %>><%= status %></option>
                    <% }) %>
                  </select>
                </div>

                <div class="admin-filter-field">
                  <label for="finance_period">Periodo</label>
                  <select id="finance_period" name="period">
                    <option value="all" <%= financeFilters.period === 'all' ? 'selected' : '' %>>Todos</option>
                    <option value="current_month" <%= financeFilters.period === 'current_month' ? 'selected' : '' %>>Mes atual</option>
                    <option value="previous_month" <%= financeFilters.period === 'previous_month' ? 'selected' : '' %>>Mes anterior</option>
                    <option value="overdue" <%= financeFilters.period === 'overdue' ? 'selected' : '' %>>Vencidos</option>
                  </select>
                </div>

                <div class="admin-filter-field">
                  <label for="finance_store">Loja</label>
                  <select id="finance_store" name="store_id">
                    <option value="0" <%= !financeFilters.storeId ? 'selected' : '' %>>Todas</option>
                    <% stores.forEach((store) => { %>
                      <option value="<%= store.id %>" <%= Number(financeFilters.storeId) === Number(store.id) ? 'selected' : '' %>>
                        <%= store.store_name %>
                      </option>
                    <% }) %>
                  </select>
                </div>

                <button type="submit" class="primary-button">Filtrar</button>
              </form>

              <div class="admin-chart-panel admin-chart-panel-rich">
                <div class="admin-panel-head">
                  <div>
                    <h2>Receita mensal</h2>
                    <p><%= payments.length %> de <%= allPaymentsCount %> pagamento(s) no filtro</p>
                  </div>
                  <strong><%= financeStats.monthlyRecurringRevenue %></strong>
                </div>

                <div class="admin-chart-stats">
                  <div>
                    <span>Recebido</span>
                    <strong><%= financeStats.receivedDisplay %></strong>
                  </div>
                  <div>
                    <span>Em aberto</span>
                    <strong><%= financeStats.openDisplay %></strong>
                  </div>
                  <div>
                    <span>Vencido</span>
                    <strong><%= financeStats.overdueDisplay %></strong>
                  </div>
                  <div>
                    <span>MRR</span>
                    <strong><%= financeStats.monthlyRecurringRevenue %></strong>
                  </div>
                </div>

                <div class="admin-chart-stage">
                  <div class="admin-chart-surface" aria-hidden="true"></div>
                  <div class="admin-chart-axis">
                    <span>alta</span>
                    <span>media</span>
                    <span>base</span>
                  </div>
                  <div class="admin-chart-columns">
                    <% financeChart.columns.forEach((column) => { %>
                      <div class="admin-chart-column" title="<%= column.totalDisplay %>">
                        <div class="admin-chart-bars">
                          <span class="bar received" style="height: <%= column.receivedPercent %>%">
                            <i></i>
                          </span>
                          <span class="bar open" style="height: <%= column.openPercent %>%">
                            <i></i>
                          </span>
                        </div>
                        <strong><%= column.label %></strong>
                        <small><%= column.totalDisplay %></small>
                      </div>
                    <% }) %>
                  </div>
                </div>

                <div class="admin-chart-legend">
                  <span><i class="received"></i> Recebido</span>
                  <span><i class="open"></i> Em aberto</span>
                </div>
              </div>

              <div class="admin-data-panel">
                <div class="admin-panel-head">
                  <h2>Todos os pagamentos</h2>
                  <span><%= payments.length %> item(ns)</span>
                </div>

                <% if (!payments.length) { %>
                  <p class="saas-muted">Nenhum pagamento encontrado para o filtro atual.</p>
                <% } else { %>
                  <div class="admin-table-wrap">
                    <table class="admin-table payments-table">
                      <thead>
                        <tr>
                          <th>Loja</th>
                          <th>Descricao</th>
                          <th>Valor</th>
                          <th>Status</th>
                          <th>Vencimento</th>
                          <th>Atualizar</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% payments.forEach((payment) => { %>
                          <tr class="<%= payment.isOverdue ? 'admin-row-alert' : '' %>">
                            <td>
                              <strong><%= payment.store_name %></strong>
                              <span><%= payment.email %></span>
                            </td>
                            <td><%= payment.description || "Pagamento" %></td>
                            <td><strong><%= payment.amountDisplay %></strong></td>
                            <td>
                              <span class="admin-status-pill <%= payment.status === 'Pago' ? 'success' : payment.isOverdue ? 'danger' : 'warning' %>">
                                <%= payment.status %>
                              </span>
                            </td>
                            <td><%= payment.dueLabel %></td>
                            <td>
                              <form method="POST" action="/admin/payments/<%= payment.id %>/update" class="admin-inline-form">
                                <select name="status" aria-label="Status">
                                  <% invoiceStatuses.filter((status) => status !== "Sem cobranca").forEach((status) => { %>
                                    <option value="<%= status %>" <%= payment.status === status ? 'selected' : '' %>><%= status %></option>
                                  <% }) %>
                                </select>
                                <select name="method" aria-label="Metodo">
                                  <% paymentMethods.forEach((method) => { %>
                                    <option value="<%= method %>" <%= payment.method === method ? 'selected' : '' %>><%= method %></option>
                                  <% }) %>
                                </select>
                                <input type="date" name="paid_at" value="<%= payment.paid_at || '' %>" aria-label="Data de pagamento" />
                                <button type="submit" class="secondary-button">Salvar</button>
                              </form>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                <% } %>
              </div>
            </div>
          </section>
        <% } %>

        <% if (activeTab === "clientes") { %>
          <section class="admin-data-panel">
            <div class="admin-panel-head">
              <h2>Lojas cadastradas</h2>
              <span><%= stores.length %> loja(s)</span>
            </div>

            <% if (!stores.length) { %>
              <p class="saas-muted">Nenhuma loja cadastrada ainda.</p>
            <% } else { %>
              <div class="admin-table-wrap">
                <table class="admin-table stores-table">
                  <thead>
                    <tr>
                      <th>Loja</th>
                      <th>Contato</th>
                      <th>Documento</th>
                      <th>Sorteios</th>
                      <th>Participantes</th>
                      <th>Cadastro</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% stores.forEach((store) => { %>
                      <tr>
                        <td>
                          <strong><%= store.store_name %></strong>
                          <span><%= store.email %></span>
                        </td>
                        <td><%= store.whatsapp %></td>
                        <td><%= store.cpf_cnpj %></td>
                        <td><%= store.total_raffles %></td>
                        <td><%= store.participant_entries %></td>
                        <td><%= store.createdAtLabel %></td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            <% } %>
          </section>
        <% } %>

        <% if (activeTab === "planos") { %>
          <section class="admin-plan-grid">
            <% planCatalog.forEach((plan) => { %>
              <article class="admin-plan-card <%= plan.plan_key === 'iniciante' ? 'muted' : '' %>">
                <div class="admin-plan-head">
                  <div>
                    <span>Plano</span>
                    <h2><%= plan.plan_name %></h2>
                  </div>
                  <strong><%= plan.monthly_price %></strong>
                </div>

                <form method="POST" action="/admin/plans/<%= plan.plan_key %>" class="admin-plan-form">
                  <div>
                    <label for="plan_price_<%= plan.plan_key %>">Valor mensal</label>
                    <input id="plan_price_<%= plan.plan_key %>" type="text" name="monthly_price" value="<%= plan.monthly_price %>" />
                  </div>

                  <div>
                    <label for="plan_limit_<%= plan.plan_key %>">Limite de sorteios</label>
                    <input
                      id="plan_limit_<%= plan.plan_key %>"
                      type="number"
                      name="raffle_limit"
                      min="0"
                      value="<%= plan.raffle_limit %>"
                      <%= plan.plan_key === 'luck' ? 'readonly' : '' %>
                    />
                    <p class="field-help"><%= plan.unlimitedRaffles ? "0 significa sorteios ilimitados." : "Total de sorteios permitidos para testar." %></p>
                  </div>

                  <label class="checkbox-row admin-checkbox" for="plan_export_<%= plan.plan_key %>">
                    <input
                      id="plan_export_<%= plan.plan_key %>"
                      type="checkbox"
                      name="export_clients"
                      value="1"
                      <%= plan.export_clients ? 'checked' : '' %>
                      <%= plan.plan_key === 'luck' ? 'disabled' : '' %>
                    />
                    Permitir exportar clientes
                  </label>

                  <% if (plan.plan_key === 'luck') { %>
                    <input type="hidden" name="export_clients" value="1" />
                  <% } %>

                  <div class="admin-plan-description-field">
                    <label for="plan_description_<%= plan.plan_key %>">Descricao</label>
                    <textarea id="plan_description_<%= plan.plan_key %>" name="description" rows="3"><%= plan.description %></textarea>
                  </div>

                  <button type="submit" class="primary-button">Salvar plano</button>
                </form>
              </article>
            <% }) %>
          </section>
        <% } %>

        <% if (activeTab === "assinantes") { %>
          <section class="admin-subscriber-grid">
            <% if (!subscriberRows.length) { %>
              <p class="saas-muted">Nenhuma loja cadastrada ainda.</p>
            <% } %>

            <% subscriberRows.forEach((store) => { %>
              <article class="admin-subscriber-card <%= store.invoiceOverdue ? 'overdue' : '' %>">
                <div class="admin-subscriber-head">
                  <div>
                    <span class="admin-status-pill <%= store.subscriptionActive ? 'success' : store.invoiceOverdue ? 'danger' : 'muted' %>">
                      <%= store.plan_status %>
                    </span>
                    <h2><%= store.store_name %></h2>
                    <p><%= store.email %> | <%= store.whatsapp %></p>
                  </div>
                  <strong><%= store.monthlyPriceDisplay %></strong>
                </div>

                <div class="admin-subscriber-meta">
                  <div>
                    <span>Plano</span>
                    <strong><%= store.plan_name %></strong>
                  </div>
                  <div>
                    <span>Fatura</span>
                    <strong><%= store.invoice_status %></strong>
                  </div>
                  <div>
                    <span>Vencimento</span>
                    <strong><%= store.invoiceDueLabel %></strong>
                  </div>
                  <div>
                    <span>Pagamentos</span>
                    <strong><%= store.payments_count %></strong>
                  </div>
                </div>

                <details class="admin-subscription-details">
                  <summary>Editar assinatura</summary>

                  <form method="POST" action="/admin/assinantes/<%= store.id %>/plan" class="admin-subscription-form">
                    <div>
                      <label for="plan_name_<%= store.id %>">Plano</label>
                      <select id="plan_name_<%= store.id %>" name="plan_name">
                        <% planNames.forEach((planName) => { %>
                          <option value="<%= planName %>" <%= store.plan_name === planName ? 'selected' : '' %>><%= planName %></option>
                        <% }) %>
                      </select>
                    </div>

                    <div>
                      <label for="plan_status_<%= store.id %>">Status do plano</label>
                      <select id="plan_status_<%= store.id %>" name="plan_status">
                        <% planStatuses.forEach((status) => { %>
                          <option value="<%= status %>" <%= store.plan_status === status ? 'selected' : '' %>><%= status %></option>
                        <% }) %>
                      </select>
                    </div>

                    <div>
                      <label for="invoice_due_at_<%= store.id %>">Vencimento</label>
                      <input id="invoice_due_at_<%= store.id %>" type="date" name="invoice_due_at" value="<%= store.invoiceDueInput %>" />
                    </div>

                    <div>
                      <label for="add_days_<%= store.id %>">Adicionar dias</label>
                      <input id="add_days_<%= store.id %>" type="number" name="add_days" min="0" max="3650" placeholder="0" />
                    </div>

                    <div class="admin-notes-field">
                      <label for="admin_notes_<%= store.id %>">Observacoes</label>
                      <input id="admin_notes_<%= store.id %>" type="text" name="admin_notes" value="<%= store.admin_notes %>" />
                    </div>

                    <button type="submit" class="primary-button">Salvar assinatura</button>
                  </form>
                </details>
              </article>
            <% }) %>
          </section>
        <% } %>
      </main>
    </div>
    <script src="/admin.js"></script>
  </body>
</html>
